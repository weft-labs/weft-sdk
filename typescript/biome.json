{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": { "includes": ["**", "!dist", "!node_modules", "!src/generated"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "warn" },
      "correctness": { "noUnusedVariables": "warn" }
    }
  }
}
