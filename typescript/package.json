{
  "name": "@weft-labs/sdk",
  "version": "0.10.0",
  "description": "Unified Weft SDK for the Weft API and x402 Facilitator",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "weft": "./cli/weft.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./facilitator": {
      "import": {
        "types": "./dist/facilitator/index.d.mts",
        "default": "./dist/facilitator/index.mjs"
      },
      "require": {
        "types": "./dist/facilitator/index.d.ts",
        "default": "./dist/facilitator/index.js"
      }
    },
    "./facilitator/middleware": {
      "import": {
        "types": "./dist/facilitator/middleware/index.d.mts",
        "default": "./dist/facilitator/middleware/index.mjs"
      },
      "require": {
        "types": "./dist/facilitator/middleware/index.d.ts",
        "default": "./dist/facilitator/middleware/index.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      },
      "require": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run && pnpm run test:quickstarts",
    "test:quickstarts": "pnpm run build && node ../scripts/test-typescript-quickstarts.mjs",
    "lint": "biome check --write",
    "lint:check": "biome check",
    "format": "biome format --write",
    "format:check": "biome format",
    "generate": "../scripts/generate-typescript.sh",
    "smoke": "pnpm run build && node ../scripts/weft-smoke.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "weft",
    "x402",
    "payments",
    "micropayments",
    "coinbase",
    "sdk"
  ],
  "author": "Weft Labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/weft-labs/weft-sdk"
  },
  "peerDependencies": {
    "@x402/core": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^26.1.2",
    "fast-check": "^4.8.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "files": [
    "cli",
    "dist",
    "docs",
    "examples",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "packageManager": "pnpm@10.33.4"
}
